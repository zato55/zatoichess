        if(t.created_by!==user.id)return json({error:'Sadece turnuva sahibi erişebilir.'},{status:403});
        const rows=(await env.DB.prepare(`SELECT id incidentId,enforcement_id enforcementId,status,action,detail,created_at createdAt,resolved_at resolvedAt FROM tournament_share_retention_policy_incidents WHERE tournament_id=? ORDER BY created_at DESC LIMIT 50`).bind(id).all<any>()).results||[];
        return json({version:'v83',rows});
      }catch{return json({error:'Policy olay geçmişi alınamadı.'},{status:400});}
    }
    const tournamentShareV83ScheduledReplay=url.pathname.match(/^\/api\/tournaments\/([^/]+)\/share\/health\/retention\/scheduled-replay-v83$/);
    if(tournamentShareV83ScheduledReplay && request.method==='POST'){
      if(!env.DB)return json({error:'D1 yapılandırılmamış.'},{status:503});
      const user=await authUser(request,env); if(!user)return json({error:'Giriş gerekli.'},{status:401});
      try{
        const id=decodeURIComponent(tournamentShareV83ScheduledReplay[1]);
