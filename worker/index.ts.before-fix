        if(!t)return json({error:'Turnuva bulunamadı.'},{status:404});
        if(t.created_by!==user.id)return json({error:'Sadece turnuva sahibi erişebilir.'},{status:403});
        const now=new Date();
        await runScheduledRetentionReplay(env.DB,now);
        const row=await env.DB.prepare(`SELECT id,run_at runAt,status,audit_candidates auditCandidates,cache_candidates cacheCandidates,alert_candidates alertCandidates,remediation_candidates remediationCandidates,integrity_sha256 integritySha256,payload FROM tournament_share_scheduled_retention_replays WHERE tournament_id=? ORDER BY run_at DESC LIMIT 1`).bind(id).first<any>();
        return json({version:'v83',row});
      }catch{return json({error:'Zamanlanmış saklama replayi alınamadı.'},{status:400});}
    }
    const tournamentShareV83ScheduledReplayHistory=url.pathname.match(/^\/api\/tournaments\/([^/]+)\/share\/health\/retention\/scheduled-replay-v83\/history$/);
    if(tournamentShareV83ScheduledReplayHistory && request.method==='GET'){
      if(!env.DB)return json({error:'D1 yapılandırılmamış.'},{status:503});
      const user=await authUser(request,env); if(!user)return json({error:'Giriş gerekli.'},{status:401});
