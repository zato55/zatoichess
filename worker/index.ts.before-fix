        const t=await env.DB.prepare(`SELECT id,created_by FROM tournaments WHERE id=?`).bind(id).first<any>();
        if(!t)return json({error:'Turnuva bulunamadı.'},{status:404});
        if(t.created_by!==user.id)return json({error:'Sadece turnuva sahibi erişebilir.'},{status:403});
        const rows=(await env.DB.prepare(`SELECT id,run_at runAt,status,audit_candidates auditCandidates,cache_candidates cacheCandidates,alert_candidates alertCandidates,remediation_candidates remediationCandidates,integrity_sha256 integritySha256,created_at createdAt FROM tournament_share_scheduled_retention_replays WHERE tournament_id=? ORDER BY run_at DESC LIMIT 30`).bind(id).all<any>()).results||[];
        return json({version:'v83',rows});
      }catch{return json({error:'Zamanlanmış replay geçmişi alınamadı.'},{status:400});}
    }
    const tournamentShareV84Compare=url.pathname.match(/^\/api\/tournaments\/([^/]+)\/share\/health\/verification-replay-comparison-v84$/);
    if(tournamentShareV84Compare && request.method==='POST'){
      if(!env.DB)return json({error:'D1 yapılandırılmamış.'},{status:503});
      const user=await authUser(request,env); if(!user)return json({error:'Giriş gerekli.'},{status:401});
